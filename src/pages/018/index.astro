---

<Layout title="Circle Carousel">
  <section class="fv">
    <Title
      title="Circle Carousel"
      tags={["typescript", "gsap", "draggable"]}
      className="c-title__white c-title__other"
    />
    <div class="circle">
      <div class="carousel">
        {
          slides.map((slide) => (
            <li class="slide">
              <img src={slide.image} alt="" />
            </li>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  body {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  .fv {
    width: 100%;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #000;
    color: #fff;
    position: relative;
    overflow: hidden;
  }
  ul,
  li {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .carousel {
    position: relative;
    width: 38vw;
    height: 38vw;

    @media (max-width: 768px) {
      width: 90vw;
      height: 90vw;
    }
  }
  .slide {
    width: 15vw;
    height: 15vw;
    aspect-ratio: 1/1;
    border-radius: 50%;
    overflow: hidden;
    opacity: 0;
    @media (max-width: 768px) {
      width: 30vw;
      height: 30vw;
    }
  }
  .slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
<script>
  import gsap from "gsap";
  import { Draggable } from "gsap/Draggable";
  gsap.registerPlugin(Draggable);
  class CircleCarousel {
    private slides: NodeListOf<HTMLLIElement>;
    private carousel: HTMLDivElement | null = null;
    private rotation = 0;
    constructor() {
      this.carousel = document.querySelector<HTMLDivElement>(".carousel");
      this.slides = document.querySelectorAll<HTMLLIElement>(".slide");
      if (!this.carousel) return;
      this.init();
    }

    private init() {
      this.fade();
      this.circlePosition();
      this.bindDrag();
    }

    private fade() {
      gsap.to(this.slides, {
        opacity: 1,
        duration: 1,
        ease: "power2.inOut",
        stagger: {
          each: 0.1,
          from: "start",
        },
      });
    }

    private circlePosition() {
      const isMobile = window.innerWidth <= 768;
      const radius = isMobile ? 600 : 300;
      const angle = 360 / this.slides.length;
      this.slides.forEach((slide, index) => {
        const currentAngle = index * angle;
        const radian = (currentAngle * Math.PI) / 180;
        const x = Math.sin(radian) * radius * 0.06 + "vw";
        const y = -Math.cos(radian) * radius * 0.06 + "vw";

        gsap.set(slide, {
          position: "absolute",
          left: "50%",
          top: "50%",
          xPercent: -50,
          yPercent: -50,
          x,
          y,
        });
      });
    }

    private rotate() {
      if (!this.carousel || !this.slides) return;

      const angle = 360 / this.slides.length;

      this.rotation += angle;

      gsap.to(this.carousel, {
        rotation: this.rotation,
        duration: 1,
      });

      this.slides.forEach((slide) => {
        gsap.to(slide, {
          rotation: -this.rotation,
          duration: 1,
        });
      });
    }

    private bindDrag() {
      if (!this.carousel) return;
      Draggable.create(this.carousel, {
        type: "rotation",
        inertia: true,
        onDrag: () => {
          const rotation = gsap.getProperty(this.carousel, "rotation");
          this.slides.forEach((slide) => {
            gsap.set(slide, {
              rotation: -Number(rotation),
            });
          });
        },
      });
    }
  }
  new CircleCarousel();
</script>
