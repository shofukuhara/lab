---

<Layout title="Circle Carousel">
  <section class="fv">
    <Title
      title="Circle Carousel"
      tags={["javascript", "animation", "variable-font"]}
      className="c-title__white c-title__other"
    />
    <div class="circle">
      <div class="carousel">
        {
          slides.map((slide) => (
            <li class="slide">
              <img src={slide.image} alt="" />
            </li>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  body {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  .fv {
    width: 100%;
    height: 100svh;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #000;
    color: #fff;
    position: relative;
    overflow: hidden;
  }
  ul,
  li {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .carousel {
    position: relative;
    width: 50vw;
    height: 50vw;
  }
  .slide {
    width: 20vw;
    height: 20vw;
    aspect-ratio: 1/1;
    border-radius: 50%;
    overflow: hidden;
  }
  .slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
<script>
  import gsap from "gsap";
  import { Draggable } from "gsap/Draggable";
  gsap.registerPlugin(Draggable);
  class CircleCarousel {
    private slides: NodeListOf<HTMLLIElement> | null = null;
    private carousel: HTMLDivElement | null = null;
    constructor() {
      this.carousel = document.querySelector<HTMLDivElement>(".carousel");
      this.slides = document.querySelectorAll<HTMLLIElement>(".slide");
      if (!this.carousel) return;
      this.init();
    }

    init() {
      this.circlePosition();
      // this.rotate();
      this.bindDrag();

      window.addEventListener("resize", () => {
        this.circlePosition();
      });
    }

    private circlePosition() {
      if (!this.slides) return;
      const radius = 300;
      const angle = 360 / this.slides.length;
      this.slides.forEach((slide, index) => {
        const currentAngle = index * angle;
        const radian = (currentAngle * Math.PI) / 180;

        const x = Math.sin(radian) * radius;
        const y = -Math.cos(radian) * radius;

        gsap.set(slide, {
          position: "absolute",
          left: "50%",
          top: "50%",
          xPercent: -50,
          yPercent: -50,
          x,
          y,
        });
      });
    }

    private rotate() {
      if (!this.carousel || !this.slides) return;

      const angle = 360 / this.slides.length;

      gsap.to(this.carousel, {
        rotation: angle,
        duration: 1,
      });
    }

    private bindDrag() {
      if (!this.carousel) return;

      Draggable.create(this.carousel, {
        type: "rotation",
      });
    }
  }
  new CircleCarousel();
</script>
