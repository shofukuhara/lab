---
import Title from "../../components/ui/Title.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout title="scroll scale animation">
  <section class="fv">
    <Title
      title="Scroll Scale Animation"
      tags={["typescript", "gsap", "scrolltrigger", "animation"]}
      className="c-title__white c-title__other"
    />
    <div class="box">
      <span class="text">Scroll</span>
      <span class="line"></span>
    </div>
  </section>
  <div class="grid">
    <div class="area">
      <div class="inner">
        <div class="item">
          <img
            src="https://images.unsplash.com/photo-1439792675105-701e6a4ab6f0?fm=jpg&q=80&w=1600&auto=format&fit=crop"
            alt=""
          />
        </div>
        <div class="item">
          <img
            src="https://images.unsplash.com/photo-1485470733090-0aae1788d5af?fm=jpg&q=80&w=1600&auto=format&fit=crop"
            alt=""
          />
        </div>
        <div class="item">
          <img
            src="https://images.unsplash.com/photo-1544411047-c491e34a24e0?fm=jpg&q=80&w=1600&auto=format&fit=crop"
            alt=""
          />
        </div>
      </div>
      <div class="inner">
        <div class="item">
          <img
            src="https://images.unsplash.com/photo-1485470733090-0aae1788d5af?fm=jpg&q=80&w=1600&auto=format&fit=crop"
            alt=""
          />
        </div>
        <div class="item">
          <img
            src="https://images.unsplash.com/photo-1439792675105-701e6a4ab6f0?fm=jpg&q=80&w=1600&auto=format&fit=crop"
            alt=""
          />
        </div>
        <div class="item">
          <img
            src="https://images.unsplash.com/photo-1516410529446-2c777cb7366d?fm=jpg&q=80&w=1600&auto=format&fit=crop"
            alt=""
          />
        </div>
      </div>
      <div class="inner">
        <div class="item">
          <img
            src="https://images.unsplash.com/photo-1516410529446-2c777cb7366d?fm=jpg&q=80&w=1600&auto=format&fit=crop"
            alt=""
          />
        </div>
        <div class="item">
          <img
            src="https://images.unsplash.com/photo-1544411047-c491e34a24e0?fm=jpg&q=80&w=1600&auto=format&fit=crop"
            alt=""
          />
        </div>
        <div class="item">
          <img
            src="https://images.unsplash.com/photo-1485470733090-0aae1788d5af?fm=jpg&q=80&w=1600&auto=format&fit=crop"
            alt=""
          />
        </div>
      </div>
    </div>
  </div>
  <div class="section">
    <p class="end">END</p>
  </div>
</Layout>
<style>
  body {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  .fv {
    width: 100%;
    height: 100svh;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #000;
    color: #fff;
    position: relative;
  }
  .box {
    position: absolute;
    left: 0;
    right: 0;
    margin: auto;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .line {
    width: 1px;
    height: 40px;
    display: block;
    background-color: #fff;

    animation: scroll 2s infinite;
  }
  @keyframes scroll {
    0% {
      transform: scale(1, 0);
      transform-origin: 0 0;
    }
    50% {
      transform: scale(1, 1);
      transform-origin: 0 0;
    }
    51% {
      transform: scale(1, 1);
      transform-origin: 0 100%;
    }
    100% {
      transform: scale(1, 0);
      transform-origin: 0 100%;
    }
  }
  .section {
    overflow: clip;
  }
  .grid {
    height: 400vh;
    background-color: #000;
    overflow: clip;
  }
  .area {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    place-content: center;
    gap: 80px;
    height: 100dvh;
    position: sticky;
    top: 0;
    left: 0;
    @media (max-width: 768px) {
      gap: 24px;
    }
  }
  .inner {
    display: grid;
    grid-template-rows: repeat(3, 1fr);
    gap: 80px;
    @media (max-width: 768px) {
      gap: 24px;
    }
  }

  .item {
    height: calc((100svh - 160px) / 3);
    overflow: hidden;
    @media (max-width: 768px) {
      height: calc((100dvh - 48px) / 3);
    }
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .section {
    width: 100%;
    height: 100vh;
    background-color: #000;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .end {
    color: #fff;
    font-size: 32px;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);
  class ScrollScaleAnimation {
    private trigger: HTMLElement | null = null;
    private itemList: NodeListOf<HTMLElement>;
    private imageList: NodeListOf<HTMLElement>;

    constructor() {
      this.trigger = document.querySelector(".grid");
      this.itemList = document.querySelectorAll(".item");
      this.imageList = document.querySelectorAll("img");
      this.init();
    }

    private init() {
      this.scroll();
      this.windowResize();
    }

    private windowResize() {
      window.addEventListener("resize", () => {
        ScrollTrigger.refresh();
      });
    }

    private scroll() {
      if (!this.trigger) return;
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: this.trigger,
          start: "top top",
          end: "center top",
          // markers: true,
          scrub: 1,
          invalidateOnRefresh: true,
        },
      });
      tl.to(
        this.itemList,
        {
          width: () => window.innerWidth,
          height: () => window.innerHeight,
          duration: 1.5,
        },
        "<",
      );
      tl.to(
        this.imageList,
        {
          scale: 1.5,
          duration: 1.5,
        },
        "<",
      );
    }
  }
  new ScrollScaleAnimation();
</script>
