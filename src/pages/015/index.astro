---
import Title from "../../components/ui/Title.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Image Mosaic">
  <section class="fv">
    <Title
      title="Image Mosaic"
      tags={["javascript", "animation"]}
      className="c-title__white c-title__other"
    />
    <canvas data-canvas></canvas>
  </section>
  <style>
    body {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    .fv {
      width: 100%;
      height: 100svh;
      display: flex;
      justify-content: center;
      align-items: center;
      background-color: #000;
      color: #fff;
      position: relative;
    }
  </style>
  <script>
    class ImageMosaic {
      private canvas: HTMLCanvasElement;
      private ctx: CanvasRenderingContext2D;
      private blockSize = 8;
      private image = new Image();
      constructor() {
        const canvas =
          document.querySelector<HTMLCanvasElement>("[data-canvas]");
        if (!canvas) throw new Error("Canvas not found.");

        const ctx = canvas.getContext("2d");
        if (!ctx) throw new Error("2D context not supported.");

        this.canvas = canvas;
        this.ctx = ctx;

        this.init();
      }

      private init() {
        console.log(this.canvas);
        this.loadImage();
        this.bindEvents();
      }

      private bindEvents() {
        window.addEventListener("resize", () => {
          this.resizeCanvas();
          this.draw();
        });
      }

      private loadImage() {
        this.image.src = "../image.png";
        this.image.onload = () => {
          this.resizeCanvas();
          this.draw();
        };
      }

      private resizeCanvas() {
        const aspect = this.image.width / this.image.height;
        const width = window.innerWidth / 2;
        const height = width / aspect;
        this.canvas.width = width;
        this.canvas.height = height;
      }

      private draw() {
        this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
        this.ctx.drawImage(
          this.image,
          0,
          0,
          this.canvas.width,
          this.canvas.height,
        );
        const imageData = this.ctx.getImageData(
          0,
          0,
          this.canvas.width,
          this.canvas.height,
        );

        for (let y = 0; y < this.canvas.height; y += this.blockSize) {
          for (let x = 0; x < this.canvas.width; x += this.blockSize) {
            const index = (y * this.canvas.width + x) * 4;

            const r = imageData.data[index];
            const g = imageData.data[index + 1];
            const b = imageData.data[index + 2];

            this.ctx.fillStyle = `rgb(${r}, ${g}, ${b})`;
            this.ctx.fillRect(x, y, this.blockSize, this.blockSize);
          }
        }
      }
    }

    new ImageMosaic();
  </script>
</Layout>
