---
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/ui/Button.astro";
import Title from "../../components/ui/Title.astro";
---

<Layout title="003. a11y modal">
  <Title title="a11y modal" tags={["js", "modal", "accessibility"]} />
  <div class="demo">
    <Button type="button" data-modal-open="" aria-expanded="false"
      >Open Modal</Button
    >
  </div>
  <dialog>
    <a href="#">Modal</a>
    <button
      class="close-button"
      data-modal-close=""
      aria-label="モーダルを閉じる"
      style="pointer-events: none;">✕</button
    >
  </dialog>
  <script>
    // @ts-nocheck
    import { gsap } from "gsap";
    class DialogControl {
      constructor() {
        this.button = {
          open: document.querySelector("[data-modal-open]"),
          close: document.querySelector("[data-modal-close]"),
        };
        this.dialog = document.querySelector("dialog");
        this.init();
      }

      init() {
        this.button.open.addEventListener("click", () => {
          this._open();
          this._lockScroll();
        });
        this.button.close.addEventListener("click", () => {
          this._close();
          this._unlockScroll();
        });

        this._esc();
      }

      _open() {
        this.dialog.showModal();
        this.button.open.setAttribute("aria-expanded", "true");
        gsap.to(this.dialog, {
          opacity: 1,
          duration: 0.3,
          ease: "power2.out",
          onComplete: () => {
            this.button.close.style.pointerEvents = "auto";
            this.button.close.focus();
          },
        });
      }

      _close() {
        this.button.open.setAttribute("aria-expanded", "false");
        this.button.close.style.pointerEvents = "none";
        gsap.to(this.dialog, {
          opacity: 0,
          duration: 0.3,
          ease: "power2.out",
          onComplete: () => {
            this.dialog.close();
          },
        });
      }

      _lockScroll() {
        this._scrollY = window.scrollY;
        document.body.style.position = "fixed";
        document.body.style.top = `-${this._scrollY}px`;
        document.body.style.width = "100%";
      }

      _unlockScroll() {
        document.body.style.position = "";
        document.body.style.top = "";
        document.body.style.width = "";
        window.scrollTo(0, this._scrollY);
      }

      _esc() {
        this.dialog.addEventListener("cancel", (e) => {
          e.preventDefault();
          this._close();
        });
      }
    }

    new DialogControl();
  </script>
</Layout>
<style>
  body {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    overflow-y: scroll;
    max-width: 1280px;
    padding: 0 16px;
    margin: 0 auto;
    position: relative;
  }
  .fv {
    width: 100%;
    height: 100svh;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #000;
    color: #fff;
    position: relative;
  }
  .open-button {
    display: inline-flex;
    align-items: center;
    padding: 10px 24px;
    font-size: 15px;
    font-weight: 500;
    color: #fff;
    background: #000;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    letter-spacing: 0.02em;
    transition:
      opacity 0.15s,
      transform 0.1s;
    mix-blend-mode: difference;
  }
  .close-button {
    position: fixed;
    top: 16px;
    right: 16px;
    display: inline-flex;
    align-items: center;
    padding: 10px 24px;
    font-size: 15px;
    font-weight: 500;
    color: #fff;
    background: #000;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    letter-spacing: 0.02em;
    transition:
      opacity 0.15s,
      transform 0.1s;
  }

  .button:hover {
    opacity: 0.85;
  }

  .button:active {
    transform: scale(0.97);
  }
  .demo {
    width: 100%;
    height: 50vh;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
  }
  dialog {
    background-color: #ffffff;
    width: 100%;
    height: 100svh;
    max-width: 100%;
    max-height: 100%;
    padding: 0;
    border: none;
    &[open] {
      display: flex;
      align-items: center;
      justify-content: center;
    }
  }
  dialog {
    opacity: 0;
  }
</style>
