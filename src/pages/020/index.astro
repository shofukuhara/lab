---
import Button from "../../components/ui/Button.astro";
import Title from "../../components/ui/Title.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Image Flip Transition">
  <section class="fv">
    <Title
      title="Image Flip Transition"
      tags={["typescript", "gsap", "animation"]}
      className="c-title__white c-title__other"
    />
    <div class="content">
      <div data-grid></div>
      <Button
        type="button"
        class:list={["c-button--secondary", "c-button--lg"]}
        data-trigger="">クリック</Button
      >
    </div>
  </section>
  <style>
    body {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    .fv {
      width: 100%;
      height: 100svh;
      display: flex;
      justify-content: center;
      align-items: center;
      background-color: #000;
      color: #fff;
      position: relative;
    }
    .content {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 24px;
    }
    [data-grid] {
      display: grid;
      grid-template-columns: repeat(10, 1fr);
      width: 340px;
      height: 340px;
      padding-top: 40px;
    }

    :global([data-tile]) {
      background-image: url("../image.png");
      background-size: 340px 340px;
      background-repeat: no-repeat;
      background-position: center;
    }
  </style>
  <script>
    import { gsap } from "gsap";
    class FlipTransition {
      private grid: HTMLElement | null = null;
      private columns = 10;
      private rows = 10;

      constructor() {
        this.grid = document.querySelector<HTMLElement>("[data-grid]");

        if (!this.grid) return;

        this.init();
        this.events();
      }

      private init() {
        this.createTiles();
      }

      private events() {
        const trigger = document.querySelector<HTMLElement>("[data-trigger]");

        if (!trigger) return;

        trigger.addEventListener("click", () => {
          this.animateTiles();
        });
      }

      private createTiles() {
        if (!this.grid) return;

        for (let y = 0; y < this.rows; y++) {
          for (let x = 0; x < this.columns; x++) {
            const tile = document.createElement("div");

            tile.dataset.tile = "";
            const tileWidth = 340 / this.columns;
            const tileHeight = 340 / this.rows;
            tile.style.backgroundPosition = `${-x * tileWidth}px ${-y * tileHeight}px`;

            this.grid.appendChild(tile);
          }
        }
      }

      private animateTiles() {
        if (!this.grid) return;

        const tiles = this.grid.querySelectorAll<HTMLElement>("[data-tile]");
        gsap.set(tiles, { rotationY: 0 });
        gsap.to(tiles, {
          duration: 1,
          rotationY: 360,
          ease: "power1.inOut",
          stagger: {
            amount: 0.5,
            from: "center",
          },
        });
      }
    }

    new FlipTransition();
  </script>
</Layout>
