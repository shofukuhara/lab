---
import Title from "../../components/ui/Title.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout title="014. SVG Scroll Drawing">
  <section class="fv">
    <Title
      title="SVG Scroll Drawing"
      tags={["javascript", "gsap", "scroll"]}
      className=""
    />
    <div class="area" data-trigger="">
      <div class="box">
        <div class="svg" data-svg="">
          <svg
            width="100%"
            viewBox="0 0 680 150"
            role="img"
            style=""
            xmlns="http://www.w3.org/2000/svg"
