                  style='fill:none;stroke:rgb(11, 11, 11);color:rgb(11, 11, 11);stroke-width:3px;stroke-linecap:round;stroke-linejoin:round;opacity:1;font-family:"Anthropic Sans", -apple-system, "system-ui", "Segoe UI", sans-serif;font-size:16px;font-weight:400;text-anchor:start;dominant-baseline:auto'
