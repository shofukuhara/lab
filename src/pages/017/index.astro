---
import Title from "../../components/ui/Title.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Variable Font Animation">
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=Roboto+Flex:wght@100..1000&display=swap"
    rel="stylesheet"
  />
  <section class="fv">
    <Title
      title="Variable Font Animation"
      tags={["javascript", "animation", "variable-font"]}
      className="c-title__white c-title__other"
    />
    <p class="text">Variable<br />Animation</p>
  </section>
  <style>
    body {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    .fv {
      width: 100%;
      height: 100svh;
      display: flex;
      justify-content: center;
      align-items: center;
      background-color: #000;
      color: #fff;
      position: relative;
    }

    :global(.text),
    :global(.char) {
      --wght: 300;
      font-family: "Roboto Flex", sans-serif;
      font-size: 6rem;
      line-height: 1.2;
      text-align: center;
      font-variation-settings: "wght" var(--wght);
      @media (max-width: 768px) {
        font-size: 4rem;
      }
    }
  </style>
  <script>
    import gsap from "gsap";
    import SplitText from "gsap/SplitText";
    gsap.registerPlugin(SplitText);

    class VariableFontAnimation {
      private splitText: SplitText | null = null;
      private chars: Element[] | null = null;
      constructor() {
        this.splitText = new SplitText(".text", { type: "chars" });
        this.chars = this.splitText.chars;
        this.chars.forEach((char: Element) => {
          char.classList.add("char");
        });
        this.animate();
      }

      animate() {
        gsap.to(this.chars, {
          "--wght": 900,
          color: "#009fff",
          duration: 1,
          repeat: -1,
          stagger: {
            yoyo: true,
            from: "start",
            each: 0.2,
            repeat: 1,
          },
          ease: "sine.out",
        });
      }
    }
    new VariableFontAnimation();
  </script>
</Layout>
