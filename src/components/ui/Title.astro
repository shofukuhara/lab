---
interface Props {
  title: string;
  annotation?: string;
  tags?: string[];
  className?: string;
}

const { title, annotation, tags, className } = Astro.props as Props;
---

<div class={`c-title ${className || ""}`}>
  <h1>{title}</h1>
  {annotation && <p class="annotation">{annotation}</p>}
  {
    tags && (
      <ul class="tags">
        {tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    )
  }
</div>

<style>
  .c-title {
    margin: 32px 0 64px;
    border-bottom: 1px solid #e5e5e5;
    padding-bottom: 32px;
  }

  .c-title__other {
    position: absolute;
    top: 24px;
    left: 24px;
    z-index: 10;
    margin: 0;
    padding: 0;
    border-bottom: none;
  }

  .c-title h1 {
    margin: 0;
    font-size: 32px;
    font-weight: 700;
    color: #333;
  }

  .c-title__white h1 {
    color: #fff;
  }

  .annotation {
    margin: 8px 0 0;
    font-size: 14px;
    color: #666;
  }

  .tags {
    display: flex;
    gap: 8px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 4px 8px;
    background-color: #f0f0f0;
    border-radius: 4px;
    font-size: 12px;
    color: #555;
  }
</style>
